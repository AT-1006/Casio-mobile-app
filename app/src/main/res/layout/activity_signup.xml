<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".signup"
    android:background="@color/white">


    <ImageView
        android:layout_width="147dp"
        android:layout_height="48dp"
        android:src="@drawable/casioblack"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="380dp"
        android:layout_height="410dp"
        android:background="@drawable/logboxborder"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.499">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:text="Create your Account"
            android:textColor="#2E2E2E"
            android:textSize="20dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/signupemail"
            android:layout_width="307dp"
            android:layout_height="47dp"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp"
            android:background="@drawable/edittxtboxsignup"
            android:drawableLeft="@drawable/email"
            android:drawablePadding="20dp"
            android:paddingLeft="20dp"
            android:text="email"
            android:textColor="#878787" />

        <EditText
            android:id="@+id/signuppasswd"
            android:layout_width="307dp"
            android:layout_height="47dp"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp"
            android:background="@drawable/edittxtboxsignup"
            android:drawableLeft="@drawable/passwd"
            android:drawablePadding="20dp"
            android:paddingLeft="20dp"
            android:text="password"
            android:textColor="#878787" />

        <EditText
            android:id="@+id/signupconfrmpasswd"
            android:layout_width="307dp"
            android:layout_height="47dp"
            android:layout_gravity="center"
            android:background="@drawable/edittxtboxsignup"
            android:drawableLeft="@drawable/confrmpasswd"
            android:drawablePadding="20dp"
            android:paddingLeft="20dp"
            android:text="confirm password"
            android:textColor="#878787" />

        <Button
            android:id="@+id/signupbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/black"
            android:text="Sign up"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tologinpage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have Account?? Login!"
            android:textColor="@color/black" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>